{
  "opencode": {
    "db_path": "%USERPROFILE%/.local/share/opencode/opencode.db",
    "poll_interval_ms": 1500,
    "max_polls": 8
  },
  "agy": {
    "providers": [
      {
        "name": "opencode-go",
        "enabled": true,
        "base_url": "https://opencode.ai/zen/go/v1",
        "api_key": "auto",
        "model": "deepseek-v4.1-flash",
        "reasoning_effort": "none",
        "timeout_ms": 4000
      },
      {
        "name": "deepseek-official",
        "enabled": true,
        "base_url": "https://api.deepseek.com/v1",
        "api_key": "YOUR_DEEPSEEK_API_KEY",
        "model": "deepseek-flash",
        "reasoning_effort": "none",
        "timeout_ms": 4000
      }
    ]
  },
  "skills": {
    "enabled": true,
    "prefix": "skill:",
    "dirs": [
      "%USERPROFILE%/.agents/skills",
      "%USERPROFILE%/.gemini/antigravity/builtin/skills"
    ],
    "auto_inject_prompt": true
  },
  "reaper": {
    "enabled": true,
    "idle_minutes": 20,
    "check_interval_minutes": 5
  },
  "share": {
    "enabled": true,
    "port": 47600,
    "max_sessions": 12,
    "active_window_minutes": 15,
    "overflow": "reject",
    "idle_ttl_minutes": 30,
    "allow_mixed_capabilities": false,
    "fallback_direct": true,
    "executable": "",
    "log_path": "%APPDATA%/acp-title-proxy/agy-share.log"
  },
  "auto_update": {
    "enabled": true,
    "check_interval_hours": 4,
    "keep_versions": 2
  }
}
